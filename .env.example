# Copy this file to .env and fill in real values.
# Never commit .env.

# Required: BotFather token
BOT_TOKEN=your_telegram_bot_token_here

# Required: your numeric Telegram user ID
OWNER_TELEGRAM_ID=123456789

# Optional: extra numeric Telegram user IDs, comma-separated
ALLOWED_USER_IDS=

# SQLite file. Created automatically on first start.
DATABASE_PATH=./data/bank_manager.db

# IANA timezone for display and daily reminders
TIMEZONE=Europe/Kyiv

# Default daily reminder time (HH:MM, 24-hour). Backend default; Settings only toggles on/off.
REMINDER_TIME=09:00

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set true only for local testing. Leave false on any shared or VPS host.
# This never grants password reveal or /backup access.
DEV_ALLOW_ANY_USER=false

# Fernet key for encrypting account login passwords at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this outside Git. Losing it makes stored passwords unrecoverable.
ACCOUNT_CREDENTIALS_KEY=
